# /etc/inittab

# Minimal BusyBox init config for debugging init hand-off.
::sysinit:/bin/echo LK_INITTAB_SYSINIT
::sysinit:/bin/sh /etc/lk_sysinit.sh

# Run lk init on the console device prepared by the guest kernel.
console::respawn:/bin/sh /etc/lk_init.sh

# Preserve an observable shutdown hook in case init exits early.
::shutdown:/bin/echo LK_INITTAB_SHUTDOWN
